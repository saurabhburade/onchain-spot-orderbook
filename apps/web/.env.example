NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: only needed when using a Privy app client.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Server-only. Required for native Privy wallet_sendCalls and transaction status streaming.
PRIVY_APP_SECRET=
# Optional: avoids a network lookup when verifying Privy access tokens on the server.
PRIVY_JWT_VERIFICATION_KEY=

# Server-only. Alchemy Wallet API key and Gas Manager policy for sponsored Monad calls.
ALCHEMY_API_KEY=
ALCHEMY_POLICY_ID=

# Monad Testnet (chain 10143). The factory fallback is the current unverified testnet deployment.
# Optional ordered, comma-separated full override. By default the app fails over across the
# currently healthy public endpoints listed for chain 10143 by ChainList.
NEXT_PUBLIC_MONAD_RPC_URLS=
# Backwards-compatible primary override; official fallbacks are appended when RPC_URLS is unset.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Market maker: submit one market trade from this Privy wallet (1-5) every MM_TAKER_EVERY rounds.
MM_TAKER_WALLET=5
# Envio HyperIndex GraphQL endpoint. Local `envio dev` defaults to this URL.
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql
# Optional per-chain overrides when Monad and Anvil indexers run separately.
NEXT_PUBLIC_MONAD_ENVIO_GRAPHQL_URL=
NEXT_PUBLIC_ANVIL_ENVIO_GRAPHQL_URL=
NEXT_PUBLIC_MONAD_SPOT_CLOB_FACTORY_ADDRESS=0xAE2D3bC901acc1B1f6fc4A7B60e16058bd9e178C
NEXT_PUBLIC_MONAD_SPOT_CLOB_LENS_ADDRESS=0xd82FC5946b63cFcDdB4706CFfe7DF248238779AA
