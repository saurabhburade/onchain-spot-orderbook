NEXT_PUBLIC_PRIVY_APP_ID=
# Public deployment URL, used to generate absolute social-card image URLs.
NEXT_PUBLIC_SITE_URL=
# Public GA4 measurement ID. Leave empty to disable Google Analytics.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-9ERGX9MK7W
# Optional: only needed when using a Privy app client.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Server-only. Required for native Privy wallet_sendCalls and transaction status streaming.
PRIVY_APP_SECRET=
# Optional: avoids a network lookup when verifying Privy access tokens on the server.
PRIVY_JWT_VERIFICATION_KEY=
# Server-only. Pays the outer EntryPoint.handleOps transaction for direct zero-fee UserOperations.
SPONSER_PK=

# Server-only. Alchemy Wallet API key and Gas Manager policy for sponsored Monad calls.
ALCHEMY_API_KEY=
ALCHEMY_POLICY_ID=

# Monad Testnet (chain 10143). Contract addresses are defined in config/contracts.ts.
# Optional ordered, comma-separated full override. By default the app fails over across the
# currently healthy public endpoints listed for chain 10143 by ChainList.
NEXT_PUBLIC_MONAD_RPC_URLS=
# Backwards-compatible primary override; official fallbacks are appended when RPC_URLS is unset.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Market maker: submit one market trade from this Privy wallet (1-5) every MM_TAKER_EVERY rounds.
MM_TAKER_WALLET=5
# Server-only Envio HyperIndex GraphQL endpoint. Local `envio dev` defaults to this URL.
ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql
# Optional server-only per-chain overrides when Monad and Anvil indexers run separately.
MONAD_ENVIO_GRAPHQL_URL=
ANVIL_ENVIO_GRAPHQL_URL=
NEXT_PUBLIC_MONAD_CLOB_DEPLOYMENT_BLOCK=63617140
NEXT_PUBLIC_MONAD_DEFAULT_POOL_ID=0x453ab8f8cee39a86e7ca582a11552cc53a761a4e2286929255ad148342d1909c

# Local Anvil (chain 31337).
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_DEFAULT_POOL_ID=0x940fa4f561e904023d97c99693c926e617384e35a8001be8c408a507c2d04645
NEXT_PUBLIC_CLOB_DEPLOYMENT_BLOCK=18196
