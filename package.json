{
  "name": "clob",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@elastic/ecs-pino-format@>=1.0.0 <1.5.0": "1.5.0",
      "@hono/node-server@>=2.0.0 <2.1.3": "2.1.3",
      "@modelcontextprotocol/sdk@>=1.0.0 <1.32.0": "1.32.0",
      "body-parser@>=1.0.0 <1.20.9": "1.20.9",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "decode-uri-component@<=0.5.0": "0.5.1",
      "envio>express": "4.22.2",
      "esbuild@>=0.27.3 <0.28.1": "0.28.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "follow-redirects@>=1.16.0 <1.16.2": "1.16.2",
      "hono@>=4.12.4 <4.13.11": "4.13.11",
      "ip-address@>=10.0.0 <10.7.4": "10.7.4",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1",
      "path-to-regexp@<0.1.13": "0.1.13",
      "qs@>=6.0.0 <6.16.1": "6.16.1",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "systeminformation@>=5.0.0 <5.33.16": "5.33.16",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "uuid@<11.1.1": "11.1.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm run check:biome && turbo run check",
    "check:biome": "biome check .",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @clob/web dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "9.1.7",
    "turbo": "2.10.11",
    "typescript": "5.8.2"
  }
}
